{
  "name": "lusk-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "generate:territory-model": "node scripts/publish-territory-model.mjs",
    "validate:territory-model": "node scripts/validate-territory-model.mjs",
    "benchmark:payload": "vitest run --config scripts/vitest.benchmark.config.ts",
    "verify:profile-pages": "node scripts/verify-profile-pages.mjs",
    "verify:ordinary-scalar-pages": "node scripts/verify-ordinary-scalar-pages.mjs",
    "verify:series-pages": "node scripts/verify-series-pages.mjs",
    "verify:series-warm-503": "node scripts/verify-series-warm-503.mjs",
    "verify:series-native-bridge": "node scripts/verify-series-native-bridge.mjs",
    "verify:mobile-cahier-overflow": "node scripts/verify-mobile-cahier-overflow.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/mozilla-headline": "^5.3.0",
    "@fontsource-variable/mozilla-text": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "echarts": "^6.1.0",
    "lucide-vue-next": "^0.576.0",
    "maplibre-gl": "^4.7.1",
    "viewerjs": "^1.14.0",
    "vue": "^3.5.40",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.8.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
