# Ignore everything at the repo root by default
/*

# ...except these files
!/.gitignore
!/README.md

# Directories the build will live in — un-ignored up front so
# future code pushes without editing this file
!/app/
!/pipeline/
!/.github/

# ADRs — the decisions the code cites — are versioned, like their
# siblings (docs/adr/0001..0003); the rest of docs/ stays local
!/docs/
/docs/*
!/docs/adr/
