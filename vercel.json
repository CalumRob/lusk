{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix app ci",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": "app/dist",
  "rewrites": [
    {
      "source": "/((?!data/).*)",
      "destination": "/index.html"
    }
  ]
}
